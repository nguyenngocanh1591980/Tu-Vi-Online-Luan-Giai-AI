info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (3ms) [Parameters=[@__p_0='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT u."Id" AS id, u."Username" AS username, CASE
          WHEN u."StarLevel" < 2 THEN 2
          WHEN u."StarLevel" > 9 THEN 9
          ELSE u."StarLevel"
      END AS "starLevel", COALESCE(u."RankTitle", 'Thành viên') AS "rankTitle", COALESCE(u."Badge", 'Thành viên') AS badge, COALESCE(u."BadgeType", 'badge_purple') AS "badgeType"
      FROM "Users" AS u
      WHERE u."Role" = 'User' OR u."RoleId" = 4 OR (u."RankTitle" IS NOT NULL AND u."RankTitle" LIKE '%Thành viên%')
      ORDER BY u."Id"
      LIMIT @__p_0
